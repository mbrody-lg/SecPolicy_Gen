WORKLOAD_VALIDATOR_VERIFY_KEYS={"validator-test-v1":{"public_key_b64":"gTl3Dqh9F19Wo1Rmw0x+zMuNipG07jeiXfYPW4/Js5Q=","tenant_ids":["tenant-a","test-organization","functional-smoke-org","another-organization","organization-a"]}}
WORKLOAD_CANDIDATE_VERIFY_KEYS={"candidate-test-v1":{"public_key_b64":"7UkoxijRwsbq6QM4kFmVYSlZJzpcY/k2NsFGFKyHN9E=","tenant_ids":["tenant-a"]}}
MONGO_URI=mongodb://mongo:27017/policydb
OPENAI_API_URL=https://api.openai.com/v1/
OPENAI_API_KEY=fake-local-policy-openai-key
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_READINESS_MODE=config_only
RAG_SOURCES_PATH=app/config/rag_sources.yaml
RAG_VALIDATE_CHROMA=false
CONFIG_PATH=/policy-agent/app/config/policy_agent.yaml
MAX_CONTENT_LENGTH=262144
SESSION_COOKIE_SECURE=false
TRUSTED_HOSTS=localhost,127.0.0.1,policy-agent
POLICY_AGENT_ALLOW_RAG_REFRESH=false
POLICY_AGENT_RAG_REFRESH_TIMEOUT_SECONDS=2400
POLICY_AGENT_ALLOW_MODEL_DOWNLOAD=0
