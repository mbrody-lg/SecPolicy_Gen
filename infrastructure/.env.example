FLASK_ENV=development
FLASK_RUN_DEBUG=0
DEBUG=false
TESTING=false
FLASK_SECRET_KEY=fake-local-flask-secret
OIDC_ISSUER_URL=http://identity.test:8080/realms/secpolicygen
OIDC_CLIENT_ID=secpolicygen-context-agent
OIDC_CLIENT_SECRET=fake-local-oidc-client-secret
POLICY_CALLBACK_TOKEN=fake-local-policy-callback-token
OIDC_REDIRECT_URI=http://localhost:5003/auth/callback
OIDC_SCOPES=openid profile email
OIDC_CA_BUNDLE=
OIDC_ALLOW_INSECURE_HTTP=true
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=fake-local-keycloak-admin-password

MONGO_URI=mongodb://mongo:27017/contextdb
POLICY_AGENT_URL=http://policy-agent:5000
VALIDATOR_AGENT_URL=http://validator-agent:5000
POLICY_AGENT_TIMEOUT_SECONDS=30
VALIDATOR_AGENT_TIMEOUT_SECONDS=30
PIPELINE_JOB_STALE_AFTER_SECONDS=1800
CONTEXT_CONFIG_PATH=/context-agent/app/config/context_agent.yaml
POLICY_CONFIG_PATH=/policy-agent/app/config/policy_agent.yaml
VALIDATOR_CONFIG_PATH=/validator-agent/app/config/validator_agent.yaml

# Local observability UI
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

OPENAI_API_KEY=fake-local-openai-key
OPENAI_API_URL=https://api.openai.com/v1/
OPENAI_STRUCTURED_API_MODE=chat_completions
OPENAI_PROVIDER_TIMEOUT_SECONDS=180
MISTRAL_API_KEY=fake-local-mistral-key
MISTRAL_API_URL=https://api.mistral.ai/v1

CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_READINESS_MODE=live
RAG_VALIDATE_CHROMA=false
POLICY_AGENT_ALLOW_RAG_REFRESH=true
POLICY_AGENT_RAG_REFRESH_TIMEOUT_SECONDS=2400
POLICY_AGENT_ALLOW_MODEL_DOWNLOAD=0

MAX_CONTENT_LENGTH=262144
SESSION_COOKIE_SECURE=false
TRUSTED_HOSTS=localhost,127.0.0.1,context-agent,policy-agent,validator-agent
